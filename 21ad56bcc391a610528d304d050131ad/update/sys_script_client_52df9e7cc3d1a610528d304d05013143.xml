        <name>Populate User Info</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

   var ga = new GlideAjax('x_857431_employee.userInfoUtil');
   ga.addParam('sysparm_name', 'getUserDetails');
   ga.addParam('sysparm_id', g_form.getValue('user'));
   ga.getXMLAnswer(getResponse);
	function getResponse(answer){
		answer = JSON.parse(answer);
		g_form.setValue('manager', answer.manager);
		g_form.setValue('email', answer.email);
		g_form.setValue('phone', answer.phone);
	}
   
}]]></script>
